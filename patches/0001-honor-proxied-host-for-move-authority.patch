+def _normalize_netloc(netloc: str, scheme: str):
+    try:
+        parsed = urlparse(f"{scheme}://{netloc}")
+        if parsed.username is not None or parsed.password is not None:
+            return None
+        port = parsed.port
+    except ValueError:
+        return None
+    hostname = (parsed.hostname or "").rstrip(".").casefold()
+    if not hostname:
+        return None
+    try:
+        hostname = ip_address(hostname).compressed
+    except ValueError:
+        pass
+    if port is None:
+        port = 443 if scheme.casefold() == "https" else 80
+    return hostname, port
+
